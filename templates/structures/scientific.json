{
  "name": "科学实验模板",
  "description": "适合物理/化学/生物等实验，包含原始数据、分析脚本、论文草稿等",
  "structure": {
    "data": {
      "raw": null,
      "calibrated": null,
      "processed": null
    },
    "code": {
      "analysis.py": "# 数据分析与可视化\nimport numpy as np\nimport matplotlib.pyplot as plt\n\n",
      "fitting.py": "# 数据拟合\n",
      "utils.py": "# 公用函数\n"
    },
    "notebooks": {
      "exploration.ipynb": "{}"
    },
    "presentation": {
      "beamer": null,
      "slides": null,
      "poster": null
    },
    "paper": {
      "sections": null,
      "figures": null,
      "references.bib": "@article{key,\n  title = {},\n  author = {},\n  year = {}\n}\n"
    },
    "figures": null,
    "docs": null,
    "README.md": "# {experiment_name}\n\n## 实验设计\n\n## 实验方法\n\n## 结果与讨论\n"
  }
}
